# ============================================
# StudySync - Main API Environment Variables
# ============================================
# Copy this file to .env and fill in your values

PORT=3001
NODE_ENV=development

# Firebase Admin SDK (get from Firebase Console > Project Settings > Service Accounts)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# CORS - URL del frontend (Vercel en producción)
FRONTEND_URL=https://frontend-miniproyecto-2.vercel.app

# Realtime Server URL
REALTIME_SERVER_URL=http://localhost:3002
